[Icon Theme]
Name=Skeu Icons Indigo Dark
Comment=Skeuomorphic icons: indigo accent, light symbolic ink for dark desktops
Example=folder
Inherits=skeu-icons-dark,skeu-icons,AdwaitaLegacy,hicolor
DisplayDepth=32
LinkOverlay=emblem-symbolic-link
LockOverlay=emblem-readonly

# No freedesktop key marks a theme as dark: desktops and libadwaita pick it by
# name or by the icon-theme setting, so the name is the contract.  Everything
# this theme does not override resolves through Inherits=, which keeps the
# variant a few hundred symlinks instead of a second copy of the artwork.
Directories=16x16/places,22x22/places,24x24/places,32x32/places,48x48/places,64x64/places,128x128/places,256x256/places,512x512/places,symbolic/actions,symbolic/categories,symbolic/devices,symbolic/emotes,symbolic/legacy,symbolic/mimetypes,symbolic/places,symbolic/status,symbolic/ui
ScaledDirectories=16x16@2x/places,22x22@2x/places,24x24@2x/places,32x32@2x/places,48x48@2x/places,64x64@2x/places,128x128@2x/places,256x256@2x/places,512x512@2x/places

[16x16/places]
Size=16
Context=Places
Type=Fixed

[22x22/places]
Size=22
Context=Places
Type=Fixed

